#include <winres.h>
#include "resource.h"
#include "version.h"

IDI_ORBIT ICON "../../resources/orbit.ico"

IDD_PROMPT DIALOGEX 0, 0, 260, 76
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Orbit"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_PROMPT_LABEL, 10, 10, 240, 10
    EDITTEXT        IDC_PROMPT_EDIT, 10, 24, 240, 14, ES_AUTOHSCROLL
    DEFPUSHBUTTON   "OK", IDOK, 146, 52, 50, 15
    PUSHBUTTON      "Cancel", IDCANCEL, 200, 52, 50, 15
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION ORBIT_VERSION_COMMA
 PRODUCTVERSION ORBIT_VERSION_COMMA
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Orbit Project"
            VALUE "FileDescription", "Orbit Browser"
            VALUE "FileVersion", ORBIT_VERSION_STR
            VALUE "InternalName", "orbit"
            VALUE "LegalCopyright", "Copyright (C) 2026"
            VALUE "OriginalFilename", "orbit.dll"
            VALUE "ProductName", "Orbit"
            VALUE "ProductVersion", ORBIT_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
